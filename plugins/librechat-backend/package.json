{
  "name": "@nospt/backstage-plugin-librechat-backend",
  "version": "0.5.0",
  "description": "Backend plugin for Backstage that proxies requests to LibreChat Agents API",
  "repository": {
    "type": "git",
    "url": "https://github.com/nosportugal/backstage-plugin-librechat"
  },
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "librechat",
    "pluginPackages": [
      "@nospt/backstage-plugin-librechat",
      "@nospt/backstage-plugin-librechat-backend"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "tsc": "tsc",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/config": "^1.3.9",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3",
    "express-promise-router": "^4.1.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.16.1",
    "@backstage/cli": "^0.36.6",
    "@types/express": "^4.17.25",
    "@types/node-fetch": "^2.6.11",
    "jest": "^29.0.0 || ^30.5.2",
    "typescript": "~5.4.5"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts"
}
