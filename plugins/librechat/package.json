{
  "name": "@nospt/backstage-plugin-librechat",
  "version": "0.6.0",
  "description": "Backstage frontend plugin adding an AI chat bubble powered by LibreChat Agents API",
  "repository": {
    "type": "git",
    "url": "https://github.com/nosportugal/backstage-plugin-librechat"
  },
  "main": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "librechat",
    "pluginPackages": [
      "@nospt/backstage-plugin-librechat",
      "@nospt/backstage-plugin-librechat-backend"
    ]
  },
  "configSchema": "config.d.ts",
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "tsc": "tsc",
    "lint": "backstage-cli package lint",
    "clean": "backstage-cli package clean",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/core-components": "^0.18.14",
    "@backstage/frontend-plugin-api": "^0.15.1",
    "@backstage/theme": "^0.7.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "lodash": "^4.17.21",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.0",
    "use-sync-external-store": "^1.7.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/config": "^1.3.9",
    "@backstage/core-app-api": "^1.20.5",
    "@backstage/frontend-dev-utils": "^0.1.6",
    "@backstage/ui": "^0.14.3",
    "@jest/environment-jsdom-abstract": "^30.5.2",
    "@remixicon/react": "^4.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "i18next": "^23.16.8",
    "jest": "^29.0.0 || ^30.5.2",
    "jsdom": "^27.4.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.4.5"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
