{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "start": "yarn workspace @nosportugal/backstage-plugin-librechat start",
    "start:backend": "yarn workspace @nosportugal/backstage-plugin-librechat-backend start",
    "build": "yarn workspaces foreach -A run build",
    "tsc": "yarn workspaces foreach -A run tsc",
    "lint": "yarn workspaces foreach -A run lint",
    "clean": "yarn workspaces foreach -A run clean"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.0.0"
}
